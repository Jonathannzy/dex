# Crypto X Analyzer Configuration
# Copy this file to .env and fill in your API credentials

# Twitter API v2 (Recommended - Get from developer.twitter.com)
TWITTER_BEARER_TOKEN=your_bearer_token_here

# OR Twitter API v1.1 (Alternative)
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Optional: CoinMarketCap API (for enhanced crypto data)
CMC_API_KEY=your_coinmarketcap_api_key

# Optional: OpenAI API (for advanced text analysis)
OPENAI_API_KEY=your_openai_api_key

# Optional: Anthropic API (alternative to OpenAI)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Database (leave as default for SQLite)
DATABASE_URL=sqlite:///crypto_analyzer.db

# Redis (leave as default for local Redis)
REDIS_URL=redis://localhost:6379